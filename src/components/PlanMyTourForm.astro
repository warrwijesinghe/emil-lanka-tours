---
import { destinations } from '@/lib/content';
import { whatsappUrl } from '@/lib/site';
const interests = ['Culture & Heritage', 'Wildlife', 'Hill Country', 'Beaches', 'Tea Country', 'Train Journey', 'Adventure', 'Local Experiences', 'Relaxation', 'Wellness'];
const accommodation = ['Budget', 'Mid-range', 'Boutique', 'Luxury', 'Already booked', 'Not sure'];
---
<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start"><form id="plan-tour-form" class="card-surface grid gap-5 p-5 md:grid-cols-2 md:p-7" aria-label="Plan my Sri Lanka tour"><div id="form-error" hidden class="rounded-2xl bg-red-50 p-4 text-sm font-semibold text-red-900 md:col-span-2"></div><div id="form-success" hidden class="rounded-2xl bg-leaf-soft p-6 text-ink md:col-span-2"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus">Tour Request Received</p><h2 class="mt-2 font-display text-3xl">Thank you for your inquiry</h2><p class="mt-3">Reference: <strong id="success-reference"></strong></p><p class="mt-2">A copy of your request has been sent to <span id="success-email"></span>.</p><div class="mt-5 flex flex-wrap gap-3"><button id="copy-reference" type="button" class="rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white">Copy Reference</button><a id="success-whatsapp" href="#" class="rounded-full border border-leaf/20 px-5 py-3 text-sm font-semibold text-leaf">Chat with Emil on WhatsApp</a><a href="/tours/" class="rounded-full border border-leaf/20 px-5 py-3 text-sm font-semibold text-leaf">Explore Tours</a></div></div><label class="grid gap-2 text-sm font-semibold text-ink">Full Name<input name="fullName" required maxlength="120" class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label><label class="grid gap-2 text-sm font-semibold text-ink">Email Address<input name="email" type="email" required maxlength="254" class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label><label class="grid gap-2 text-sm font-semibold text-ink">Country<input name="country" required maxlength="100" class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label><label class="grid gap-2 text-sm font-semibold text-ink">WhatsApp / Phone<input name="phone" required maxlength="40" class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label><label class="grid gap-2 text-sm font-semibold text-ink">Arrival Date<input name="arrivalDate" type="date" required class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label><label class="grid gap-2 text-sm font-semibold text-ink">Departure Date<input name="departureDate" type="date" required class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label><div class="grid grid-cols-2 gap-3"><label class="grid gap-2 text-sm font-semibold text-ink">Adults<input name="adults" type="number" min="1" max="30" value="2" required class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label><label class="grid gap-2 text-sm font-semibold text-ink">Children<input name="children" type="number" min="0" max="20" value="0" required class="rounded-2xl border border-ink/10 px-4 py-3 font-normal" /></label></div><label class="grid gap-2 text-sm font-semibold text-ink">Accommodation Preference<select name="accommodation" class="rounded-2xl border border-ink/10 px-4 py-3 font-normal">{accommodation.map((option) => <option value={option}>{option}</option>)}</select></label><fieldset class="md:col-span-2"><legend class="text-sm font-semibold text-ink">Travel Interests</legend><div class="mt-3 flex flex-wrap gap-2">{interests.map((interest) => <label class="cursor-pointer rounded-full border border-ink/10 px-3 py-2 text-sm text-ink/80"><input class="mr-1.5" type="checkbox" name="interests" value={interest} />{interest}</label>)}</div></fieldset><fieldset class="md:col-span-2"><legend class="text-sm font-semibold text-ink">Destinations <span class="font-normal text-ink/60">(optional)</span></legend><p class="mt-1 text-sm text-ink/65">Leave these blank if you would like Emil to recommend the best itinerary.</p><div class="mt-3 flex flex-wrap gap-2">{destinations.map((destination) => <label class="cursor-pointer rounded-full border border-ink/10 px-3 py-2 text-sm text-ink/80"><input class="mr-1.5" type="checkbox" name="destinations" value={destination.slug} />{destination.name}</label>)}</div></fieldset><label class="flex items-center gap-2 text-sm font-semibold text-ink md:col-span-2"><input name="airportPickup" type="checkbox" />Airport pickup required</label><label class="grid gap-2 text-sm font-semibold text-ink md:col-span-2">Special Requirements<textarea name="specialRequirements" rows="3" maxlength="2000" class="rounded-3xl border border-ink/10 px-4 py-3 font-normal"></textarea></label><label class="grid gap-2 text-sm font-semibold text-ink md:col-span-2">Describe your ideal Sri Lanka trip<textarea name="message" rows="6" required minlength="10" maxlength="4000" class="rounded-3xl border border-ink/10 px-4 py-3 font-normal" placeholder="Tell Emil about your travel style, interests and anything else that matters."></textarea></label><div class="md:col-span-2"><div class="cf-turnstile" data-sitekey={import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''}></div><button type="submit" class="mt-4 rounded-full bg-leaf px-6 py-3 text-sm font-semibold text-white" data-submit>Send Tour Request</button></div></form><aside class="card-surface p-5 lg:sticky lg:top-24 lg:p-6"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus">What happens next</p><h2 class="mt-3 font-display text-2xl text-ink">Personal planning with Emil</h2><p class="mt-3 text-sm leading-7 text-ink/70">Emil will review your enquiry personally and help shape the right route for your journey. Sending this form does not confirm a booking.</p><a href={whatsappUrl()} class="mt-5 inline-flex rounded-full border border-leaf/20 px-5 py-3 text-sm font-semibold text-leaf">WhatsApp Emil</a></aside></div>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><script is:inline>const form=document.querySelector('#plan-tour-form');const error=document.querySelector('#form-error');const success=document.querySelector('#form-success');const submit=document.querySelector('[data-submit]');form?.addEventListener('submit',async(event)=>{event.preventDefault();error.hidden=true;const data=new FormData(form);const token=document.querySelector('[name="cf-turnstile-response"]')?.value;if(!token){error.textContent='Please complete the spam check.';error.hidden=false;return;}const payload=Object.fromEntries(data);payload.interests=data.getAll('interests');payload.destinations=data.getAll('destinations');payload.airportPickup=data.get('airportPickup')==='on';payload.turnstileToken=token;submit.disabled=true;submit.textContent='Sending request…';try{const response=await fetch('/api/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await response.json();if(!response.ok||!result.ok)throw new Error(result.error||'Unable to send request.');document.querySelector('#success-reference').textContent=result.reference;document.querySelector('#success-email').textContent=result.email;document.querySelector('#success-whatsapp').href=`https://wa.me/${'94761917039'}?text=${encodeURIComponent(`Hi Emil,\n\nI have just submitted a Sri Lanka tour request.\n\nMy reference is:\n${result.reference}`)}`;success.hidden=false;form.querySelectorAll('input,select,textarea,button').forEach((field)=>{if(field!==document.querySelector('#copy-reference'))field.disabled=true;});success.scrollIntoView({behavior:'smooth',block:'center'});document.querySelector('#copy-reference').onclick=async()=>{await navigator.clipboard.writeText(result.reference);document.querySelector('#copy-reference').textContent='Copied';};}catch(err){error.textContent=err.message||'Unable to send request.';error.hidden=false;submit.disabled=false;submit.textContent='Send Tour Request';}});</script>
