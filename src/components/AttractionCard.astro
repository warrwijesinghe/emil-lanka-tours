---
import ContentCard from '@/components/ContentCard.astro';
import type { Destination } from '@/types/content';

interface Props {
  attraction: string;
  description: string;
  href: string;
  destination: Destination;
  image?: { src: string; alt: string };
}

const { attraction, description, destination, href, image } = Astro.props;
---
<ContentCard
  {href}
  title={attraction}
  {description}
  imageUrl={image?.src}
  imageAlt={image?.alt}
  meta={[`Attraction in ${destination.name}`]}
/>
