---
import type { Destination } from '@/types/content';

interface Props {
  attraction: string;
  description: string;
  destination: Destination;
}

const { attraction, description, destination } = Astro.props;
const image = destination.attractionImages
  ? destination.attractionImages[attraction]
  : { src: destination.mainImageUrl, alt: destination.imageAlt };
---
<article class="card-surface flex h-full flex-col overflow-hidden">
  {image && <div class="gradient-frame aspect-[16/9] overflow-hidden">
    <img src={image.src} alt={image.alt} width="1200" height="675" loading="lazy" class="h-full w-full object-cover" />
  </div>}
  <div class="flex flex-1 flex-col p-5">
    <p class="text-[11px] font-semibold uppercase tracking-[.18em] text-lotus">Attraction in {destination.name}</p>
    <h3 class="mt-2 font-display text-2xl leading-tight text-ink">{attraction}</h3>
    <p class="mt-3 text-sm leading-7 text-ink/72">{description}</p>
  </div>
</article>
