---
import ContentCard from '@/components/ContentCard.astro';
import type { Destination } from '@/types/content';

interface Props {
  attraction: string;
  description: string;
  href: string;
  destination: Destination;
}

const { attraction, description, destination, href } = Astro.props;
const image = destination.attractionImages?.[attraction];
---
<ContentCard
  {href}
  title={attraction}
  {description}
  imageUrl={image?.src}
  imageAlt={image?.alt}
  meta={[`Attraction in ${destination.name}`]}
/>
