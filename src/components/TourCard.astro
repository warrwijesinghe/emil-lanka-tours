---
import type { Tour } from '@/types/content';
interface Props { tour: Tour; priority?: boolean; variant?: 'default' | 'homepage'; }
const { tour, priority = false, variant = 'default' } = Astro.props;
---
<a href={`/tours/${tour.slug}/`} aria-label={`View tour: ${tour.title}`} class="group flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-ink/10 bg-white shadow-soft transition duration-200 hover:-translate-y-1 hover:border-leaf/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lotus/45 focus-visible:ring-offset-4"><div class="relative aspect-[16/10] overflow-hidden bg-leaf-soft"><img src={tour.mainImageUrl} alt={tour.imageAlt} width="1200" height="750" loading={priority ? 'eager' : 'lazy'} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" /></div><div class="flex flex-1 flex-col p-5 md:p-6"><p class="text-xs font-semibold uppercase tracking-[0.16em] text-lotus">{tour.durationLabel}</p><h3 class="mt-1 font-display text-2xl leading-tight text-ink md:text-3xl">{tour.title}</h3><div class="mt-4 border-l-2 border-lotus/70 pl-3"><p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-leaf/65">Route</p><p class="mt-1.5 text-sm font-medium leading-6 text-ink/80">{tour.routePoints.join(' → ')}</p></div><div class="mt-4"><p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-leaf/70">Highlights</p><ul class="mt-2 flex flex-wrap gap-2">{tour.highlights.slice(0, 3).map((item) => <li class="rounded-full bg-leaf-soft px-2.5 py-1.5 text-xs font-medium text-leaf">{item}</li>)}</ul></div>{variant === 'homepage' && <p class="mt-4 text-xs font-medium text-ink/65"><span class="font-semibold text-ink/80">Best for:</span> {tour.bestFor.join(' · ')}</p>}<span class="mt-auto flex items-center justify-between gap-3 border-t border-ink/10 pt-4 text-sm font-semibold text-leaf">View Tour <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-leaf/20 text-base transition-colors group-hover:bg-leaf group-hover:text-white">→</span></span></div></a>
