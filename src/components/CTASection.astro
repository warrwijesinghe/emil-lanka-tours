---
interface Props {
  title: string;
  description: string;
  href: string;
  label: string;
}

const { title, description, href, label } = Astro.props;
---
<section class="container-shell py-8">
  <div class="rounded-[2rem] bg-ink px-8 py-10 text-white shadow-soft md:flex md:items-center md:justify-between md:gap-8">
    <div class="max-w-2xl">
      <h2 class="font-display text-4xl">{title}</h2>
      <p class="mt-3 text-base leading-8 text-white/78">{description}</p>
    </div>
    <a href={href} class="mt-6 inline-flex rounded-full bg-white px-6 py-3.5 text-sm font-semibold text-ink md:mt-0">
      {label}
    </a>
  </div>
</section>
