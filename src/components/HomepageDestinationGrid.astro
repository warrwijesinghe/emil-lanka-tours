---
import { resolveMediaUrl } from '@/lib/media';
import type { Destination } from '@/types/content';

interface Props {
  destinations: Destination[];
}

const { destinations } = Astro.props;
const destinationThemes: Readonly<Record<string, readonly string[]>> = {
  sigiriya: ['Culture', 'Ancient cities'],
  kandy: ['Culture', 'Hill Country'],
  'nuwara-eliya': ['Tea Country', 'Highlands'],
  ella: ['Hill Country', 'Scenic Rail'],
  'yala-national-park': ['Wildlife', 'Safari'],
  galle: ['History', 'Coast'],
  mirissa: ['Coast', 'Marine life'],
  trincomalee: ['East Coast', 'Beach time']
};
---

<section class="home-band home-band-white" aria-labelledby="popular-destinations-heading">
  <div class="container-shell py-10 md:py-12">
    <div class="max-w-2xl">
      <h2 id="popular-destinations-heading" class="font-display text-4xl text-ink sm:text-5xl">Popular Sri Lanka Destinations</h2>
      <p class="mt-3 text-base leading-8 text-ink/72">Explore cultural cities, tea-covered hills, wildlife regions and coastal escapes that can become part of your private Sri Lanka journey.</p>
    </div>

    {destinations.length > 0 && (
      <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
        {destinations.map((destination) => {
          const themes = destinationThemes[destination.slug] ?? [];
          return (
            <a href={`/destinations/${destination.slug}/`} class="group flex min-h-full flex-col overflow-hidden rounded-[1.5rem] border border-ink/10 bg-white transition hover:-translate-y-1 hover:border-leaf/25 focus:outline-none focus-visible:ring-2 focus-visible:ring-leaf focus-visible:ring-offset-4">
              <div class="aspect-[4/3] overflow-hidden bg-leaf-soft">
                <img src={resolveMediaUrl(destination.mainImageUrl || destination.imageUrl)} alt={destination.imageAlt || `${destination.name}, Sri Lanka`} width="1200" height="900" sizes="(min-width: 1280px) 25vw, (min-width: 768px) 50vw, 100vw" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              </div>
              <div class="flex flex-1 flex-col p-5">
                <h3 class="font-display text-3xl leading-tight text-ink">{destination.name}</h3>
                <p class="mt-3 line-clamp-3 text-sm leading-7 text-ink/72">{destination.shortDescription}</p>
                {themes.length > 0 && <p class="mt-4 text-xs font-semibold uppercase tracking-[0.1em] text-lotus">{themes.join(' · ')}</p>}
                <span class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-leaf">Explore Destination <span aria-hidden="true" class="ml-2">→</span></span>
              </div>
            </a>
          );
        })}
      </div>
    )}

    <a href="/destinations/" class="mt-7 inline-flex min-h-11 items-center justify-center rounded-xl border border-ink/15 bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-leaf/35 hover:text-leaf focus:outline-none focus:ring-2 focus:ring-leaf focus:ring-offset-4">View All Destinations</a>
  </div>
</section>
