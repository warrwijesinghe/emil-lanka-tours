---
import { mainNav, siteName } from '@/lib/site';
const pathname = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---
<header class="sticky top-0 z-40 border-b border-[#6d0dc5]/15 bg-white/95 backdrop-blur transition-shadow duration-200" data-site-header>
  <div class="mx-auto flex h-20 w-full max-w-[1440px] items-center gap-3 px-4 sm:px-6 lg:px-8 2xl:px-12">
    <a href="/" class="shrink-0 rounded-sm leading-tight focus:outline-none focus:ring-2 focus:ring-leaf focus:ring-offset-4" aria-label={`${siteName} home`}><span class="block font-display text-xl text-leaf sm:text-2xl">Chauffeur Emil</span><span class="block text-[10px] font-bold uppercase tracking-[.16em] text-lotus sm:text-xs">Lanka Tours</span></a>
    <nav class="ml-auto hidden min-w-0 items-center justify-center gap-5 text-[15px] font-medium text-ink/75 xl:flex" aria-label="Primary navigation">{mainNav.slice(1).map((item) => <a href={item.href} class:list={['relative whitespace-nowrap rounded-sm px-0.5 py-2 transition-colors hover:text-leaf focus:outline-none focus:ring-2 focus:ring-leaf focus:ring-offset-4 after:absolute after:bottom-0 after:left-1/2 after:h-0.5 after:w-0 after:-translate-x-1/2 after:rounded-full after:bg-leaf after:transition-all hover:after:w-5', isActive(item.href) ? 'text-leaf after:w-5' : '']} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
    <a href="/plan-my-tour/" class="ml-auto hidden min-h-12 items-center justify-center whitespace-nowrap rounded-xl bg-leaf px-5 text-sm font-semibold text-white transition-colors hover:bg-[#123b1e] focus:outline-none focus:ring-2 focus:ring-leaf focus:ring-offset-4 sm:inline-flex xl:ml-0">Plan My Tour</a>
    <button type="button" class="ml-auto inline-flex h-11 w-11 items-center justify-center rounded-lg border border-ink/15 text-ink xl:hidden" aria-expanded="false" aria-controls="mobile-site-menu" aria-label="Open navigation menu" data-mobile-menu-toggle><svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 7h16M4 12h16M4 17h16" /></svg></button>
  </div>
  <div class="fixed inset-0 z-50 invisible bg-ink/35 opacity-0 transition-opacity duration-300" aria-hidden="true" data-mobile-menu-backdrop></div>
  <aside id="mobile-site-menu" class="fixed inset-y-0 right-0 z-[60] flex w-[88vw] max-w-[360px] translate-x-full flex-col bg-white px-5 py-5 shadow-2xl transition-transform duration-300" tabindex="-1" role="dialog" aria-modal="true" aria-label="Mobile navigation" aria-hidden="true" inert data-mobile-menu-panel>
    <div class="flex items-center justify-between border-b border-ink/10 pb-4"><div><span class="block font-display text-2xl text-leaf">Chauffeur Emil</span><span class="block text-[10px] font-bold uppercase tracking-[.16em] text-lotus">Lanka Tours</span></div><button type="button" class="inline-flex h-11 w-11 items-center justify-center rounded-lg border border-ink/15 text-ink" aria-label="Close navigation menu" data-mobile-menu-close>×</button></div>
    <nav class="mt-5 grid gap-1" aria-label="Mobile navigation">{mainNav.map((item) => <a href={item.href} class:list={['min-h-11 rounded-lg px-3 py-3 text-[15px] font-medium text-ink/80 transition-colors hover:bg-leaf-soft hover:text-leaf', isActive(item.href) ? 'bg-leaf-soft text-leaf' : '']} aria-current={isActive(item.href) ? 'page' : undefined} data-mobile-menu-link>{item.label}</a>)}</nav>
    <a href="/plan-my-tour/" class="mt-auto inline-flex min-h-12 items-center justify-center rounded-xl bg-leaf px-5 text-sm font-semibold text-white" data-mobile-menu-link>Plan My Tour</a>
  </aside>
</header>
<script is:inline>
  document.querySelectorAll('[data-site-header]').forEach((header) => { const toggle = header.querySelector('[data-mobile-menu-toggle]'); const panel = header.querySelector('[data-mobile-menu-panel]'); const backdrop = header.querySelector('[data-mobile-menu-backdrop]'); const close = header.querySelector('[data-mobile-menu-close]'); const closeMenu = () => { toggle?.setAttribute('aria-expanded','false'); panel?.setAttribute('aria-hidden','true'); panel.inert = true; panel?.classList.add('translate-x-full'); backdrop?.classList.add('invisible','opacity-0'); document.body.style.overflow=''; }; const openMenu = () => { toggle?.setAttribute('aria-expanded','true'); panel?.setAttribute('aria-hidden','false'); panel.inert=false; panel?.classList.remove('translate-x-full'); backdrop?.classList.remove('invisible','opacity-0'); document.body.style.overflow='hidden'; }; toggle?.addEventListener('click', () => toggle?.getAttribute('aria-expanded') === 'true' ? closeMenu() : openMenu()); close?.addEventListener('click',closeMenu); backdrop?.addEventListener('click',closeMenu); header.querySelectorAll('[data-mobile-menu-link]').forEach((link) => link.addEventListener('click', closeMenu)); });
</script>
