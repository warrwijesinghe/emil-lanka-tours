---
interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  searchPlaceholder?: string;
  searchValue?: string;
  compact?: boolean;
}

const {
  eyebrow,
  title,
  description,
  searchPlaceholder,
  searchValue = '',
  compact = false
} = Astro.props;
---
<section class:list={['container-shell', compact ? 'py-6 md:py-8' : 'py-8 md:py-10']}>
  <div class="max-w-3xl space-y-3 md:space-y-4">
    {eyebrow && <p class="text-[11px] font-semibold uppercase tracking-[0.26em] text-lotus">{eyebrow}</p>}
    <h1 class="font-display text-3xl leading-tight text-ink sm:text-4xl md:text-[3rem]">{title}</h1>
    <p class="max-w-2xl text-sm leading-7 text-ink/72 md:text-base md:leading-8">{description}</p>
  </div>
  {searchPlaceholder && (
    <form method="GET" class="mt-4 max-w-2xl md:mt-5">
      <div class="flex flex-col gap-2 rounded-[1.25rem] bg-white/88 p-2 shadow-soft sm:flex-row">
        <input
          name="q"
          value={searchValue}
          placeholder={searchPlaceholder}
          class="min-w-0 flex-1 rounded-2xl border border-transparent bg-transparent px-4 py-3 text-sm outline-none ring-0"
        />
        <button class="rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white sm:px-6">Search</button>
      </div>
    </form>
  )}
</section>
