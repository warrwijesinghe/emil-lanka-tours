---
import { destinations } from '@/lib/content';
import { hasDedicatedMedia } from '@/lib/media';

interface Props {
  title: string;
  description: string;
  imageUrl: string;
  imageAlt: string;
  destinationSlugs: string[];
  href?: string;
}

const { title, description, imageUrl, imageAlt, destinationSlugs, href } = Astro.props;
const linkedDestinations = destinationSlugs
  .map((slug) => destinations.find((destination) => destination.slug === slug))
  .filter(Boolean);
const hasImage = hasDedicatedMedia(imageUrl);
---
{href ? <a href={href} class="card-surface group flex h-full flex-col overflow-hidden transition hover:-translate-y-1 hover:border-leaf/25 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-leaf"><div class="gradient-frame aspect-[16/9] overflow-hidden">{hasImage && <img src={imageUrl} alt={imageAlt} width="1200" height="675" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />}</div><div class="flex flex-1 flex-col p-6"><h3 class="font-display text-3xl leading-tight text-ink">{title}</h3><p class="mt-3 text-sm leading-7 text-ink/72">{description}</p><div class="mt-5"><p class="text-[11px] font-semibold uppercase tracking-[.18em] text-lotus">Available in</p><div class="mt-2 flex flex-wrap gap-2">{linkedDestinations.map((destination) => <span class="rounded-full bg-leaf-soft px-3 py-1.5 text-xs font-semibold text-leaf">{destination!.name}</span>)}</div></div><span class="mt-6 inline-flex text-sm font-semibold text-leaf">Explore experience <span class="ml-2" aria-hidden="true">→</span></span></div></a> : <article class="card-surface flex h-full flex-col overflow-hidden"><div class="gradient-frame aspect-[16/9] overflow-hidden">{hasImage && <img src={imageUrl} alt={imageAlt} width="1200" height="675" loading="lazy" class="h-full w-full object-cover" />}</div><div class="flex flex-1 flex-col p-6"><h3 class="font-display text-3xl leading-tight text-ink">{title}</h3><p class="mt-3 text-sm leading-7 text-ink/72">{description}</p><div class="mt-5"><p class="text-[11px] font-semibold uppercase tracking-[.18em] text-lotus">Available in</p><div class="mt-2 flex flex-wrap gap-2">{linkedDestinations.map((destination) => <span class="rounded-full bg-leaf-soft px-3 py-1.5 text-xs font-semibold text-leaf">{destination!.name}</span>)}</div></div></div></article>}
