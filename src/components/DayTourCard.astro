---
import type { DayTour } from '@/types/content';
const { dayTour, priority = false } = Astro.props as { dayTour: DayTour; priority?: boolean };
---
<article class="flex h-full flex-col overflow-hidden rounded-[1.75rem] border border-black/6 bg-white shadow-soft"><div class="relative aspect-[16/9] overflow-hidden bg-leaf-soft"><img src={dayTour.mainImageUrl} alt={dayTour.imageAlt} width="1200" height="675" loading={priority ? 'eager' : 'lazy'} class="h-full w-full object-cover" />{dayTour.categories[0] && <span class="absolute left-4 top-4 rounded-full bg-white/92 px-3 py-1.5 text-xs font-bold text-leaf shadow-sm">{dayTour.categories[0]}</span>}</div><div class="flex flex-1 flex-col gap-4 p-5 sm:p-6"><div class="space-y-2"><h2 class="font-display text-2xl leading-tight text-ink">{dayTour.title}</h2><p class="line-clamp-3 text-sm leading-6 text-ink/72">{dayTour.shortDescription}</p></div><p class="text-sm text-ink/78"><span class="font-semibold text-leaf">Duration</span> {dayTour.durationLabel}</p><ul class="space-y-1.5 text-sm leading-6 text-ink/80">{dayTour.highlights.slice(0,3).map((highlight) => <li class="flex gap-2"><span class="text-leaf">•</span><span>{highlight}</span></li>)}</ul><a href={`/day-tours/${dayTour.slug}/`} class="mt-auto inline-flex min-h-11 items-center justify-center rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white">View Day Tour</a></div></article>
