---
import { whatsappUrl } from '@/lib/site';
---

<section class="container-shell py-10 md:py-12" aria-labelledby="final-cta-heading">
  <div class="rounded-[2rem] bg-ink px-6 py-10 text-white shadow-soft md:px-10 md:py-12">
    <p class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus-soft">Start Planning</p>
    <div class="mt-3 max-w-3xl">
      <h2 id="final-cta-heading" class="font-display text-4xl leading-tight md:text-5xl">Ready to shape your private Sri Lanka journey?</h2>
      <p class="mt-4 max-w-2xl text-base leading-8 text-white/80">Share your dates, interests and group size. Emil will help create a practical Sri Lanka route around your pace and priorities.</p>
    </div>
    <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      <a href="/plan-my-tour/" class="inline-flex min-h-12 items-center justify-center rounded-xl bg-white px-6 text-sm font-semibold text-ink transition hover:bg-sand focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-ink">Plan My Tour</a>
      <a href={whatsappUrl('Hello Emil, I would like to plan a private Sri Lanka trip.')} class="inline-flex min-h-12 items-center justify-center rounded-xl border border-white/35 px-6 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-ink" aria-label="Chat with Emil on WhatsApp">Chat with Emil</a>
    </div>
    <a href="/contact/" class="mt-5 inline-flex min-h-11 items-center text-sm font-semibold text-white underline decoration-white/40 underline-offset-4 transition hover:decoration-white focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-ink">Contact Emil</a>
  </div>
</section>
