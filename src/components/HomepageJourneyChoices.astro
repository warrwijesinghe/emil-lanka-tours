---
const journeys = [
  {
    title: 'Round Tours',
    description: 'Browse private multi-day Sri Lanka itineraries for 7, 10, 14 or 21 days, then tailor the route to your group.',
    label: 'Explore Round Tours',
    href: '/tours/',
    emphasis: true,
    icon: 'route'
  },
  {
    title: 'Day Tours',
    description: 'Add a private cultural visit, wildlife safari or scenic experience to your stay in Sri Lanka.',
    label: 'View Day Tours',
    href: '/day-tours/',
    emphasis: false,
    icon: 'sun'
  },
  {
    title: 'Custom Tour',
    description: 'Tell us your dates, interests and preferred pace, and we will prepare a private route for your group.',
    label: 'Request a Tour Plan',
    href: '/plan-my-tour/',
    emphasis: false,
    icon: 'route'
  }
];
---

<section class="bg-white/92" aria-labelledby="journey-choices-heading">
  <div class="container-shell py-10 md:py-12">
    <div class="max-w-2xl">
      <h2 id="journey-choices-heading" class="font-display text-4xl text-ink sm:text-5xl">Choose Your Sri Lanka Journey</h2>
      <p class="mt-3 text-base leading-8 text-ink/72">Whether you prefer a complete private itinerary, a tailor-made journey or a memorable day experience, start with the travel style that suits you.</p>
    </div>

    <div class="mt-7 grid gap-5 md:grid-cols-3">
      {journeys.map((journey) => (
        <article class:list={[
          'flex h-full flex-col border p-5 md:p-6',
          journey.emphasis
            ? 'rounded-[1.5rem] border-leaf/30 bg-leaf-soft/70 ring-1 ring-leaf/10'
            : 'rounded-[1.5rem] border-ink/10 bg-white'
        ]}>
          <div class="flex items-start justify-between gap-4">
            <span class:list={[
              'grid h-11 w-11 shrink-0 place-items-center rounded-xl',
              journey.emphasis ? 'bg-leaf text-white' : 'bg-leaf-soft text-leaf'
            ]} aria-hidden="true">
              {journey.icon === 'route' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="18" r="2.5"></circle><circle cx="18" cy="6" r="2.5"></circle><path d="M8.5 18h2.2A3.3 3.3 0 0 0 14 14.7v-1.4A3.3 3.3 0 0 1 17.3 10H18"></path></svg>}
              {journey.icon === 'sun' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="3.5"></circle><path d="M12 2v2.5M12 19.5V22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M2 12h2.5M19.5 12H22M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"></path></svg>}
            </span>
            {journey.emphasis && <span class="rounded-full border border-leaf/20 bg-white/80 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-[0.12em] text-leaf">Start here</span>}
          </div>
          <h3 class="mt-5 font-display text-2xl text-ink md:text-3xl">{journey.title}</h3>
          <p class="mt-3 text-sm leading-7 text-ink/72">{journey.description}</p>
          <a href={journey.href} class:list={[
            'mt-6 inline-flex min-h-11 items-center justify-center rounded-xl px-4 text-sm font-semibold transition-colors focus:outline-none focus:ring-2 focus:ring-leaf focus:ring-offset-4',
            journey.emphasis
              ? 'bg-leaf text-white hover:bg-[#123b1e]'
              : 'border border-ink/15 bg-white text-ink hover:border-leaf/35 hover:text-leaf'
          ]}>{journey.label}</a>
        </article>
      ))}
    </div>
  </div>
</section>
