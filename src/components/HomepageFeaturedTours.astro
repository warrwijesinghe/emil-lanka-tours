---
import SectionHeader from '@/components/SectionHeader.astro';
import TourCard from '@/components/TourCard.astro';
import type { Tour } from '@/types/content';

interface Props {
  tours: Tour[];
}

const { tours } = Astro.props;
---

<section id="featured-round-tours" class="bg-[#F4ECFB]/60" aria-label="Featured Sri Lanka Round Tours">
  <div class="container-shell py-10 md:py-12">
    <SectionHeader
      title="Featured Sri Lanka Round Tours"
      description="Start with one of our carefully planned private itineraries, then adjust the route, pace and experiences to suit your journey."
    />

    {tours.length > 0 && (
      <div class="mt-7 grid items-stretch gap-5 md:grid-cols-2 xl:grid-cols-3">
        {tours.map((tour) => <TourCard tour={tour} variant="homepage" />)}
      </div>
    )}

    <div class="mt-6 flex justify-center">
      <a href="/tours/" class="inline-flex min-h-11 items-center justify-center rounded-xl border border-ink/15 bg-white px-5 text-sm font-semibold text-ink transition-colors hover:border-leaf/35 hover:text-leaf focus:outline-none focus:ring-2 focus:ring-leaf focus:ring-offset-4">View All Round Tours</a>
    </div>
  </div>
</section>
