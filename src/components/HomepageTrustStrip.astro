---
const trustItems = [
  { title: 'Private Journeys', description: 'Your tour is planned for your group—not a shared coach schedule.', icon: 'group' },
  { title: 'Local Route Planning', description: 'Routes shaped around realistic Sri Lankan travel times and conditions.', icon: 'map' },
  { title: 'Flexible Pacing', description: 'More room to enjoy culture, wildlife, tea country and the coast.', icon: 'route' },
  { title: 'English-Speaking Support', description: 'Clear local assistance while planning and throughout your journey.', icon: 'message' }
] as const;
---
<section class="border-y border-ink/10 bg-white/75" aria-label="Why plan with Chauffeur Emil Lanka Tours">
  <div class="container-shell py-6 md:py-7">
    <ul class="grid gap-x-7 gap-y-6 sm:grid-cols-2 xl:grid-cols-4">
      {trustItems.map((item) => (
        <li class="flex gap-3.5">
          <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-leaf-soft text-leaf" aria-hidden="true">
            {item.icon === 'group' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3"></circle><path d="M3.75 19c.6-3 2.4-4.75 5.25-4.75s4.65 1.75 5.25 4.75"></path><path d="M16 5.75a2.5 2.5 0 0 1 0 4.5M17.25 14.6c1.85.4 3 1.85 3.3 4.4"></path></svg>}
            {item.icon === 'map' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m9 18-5 2V6l5-2 6 2 5-2v14l-5 2-6-2Z"></path><path d="M9 4v14M15 6v14"></path></svg>}
            {item.icon === 'route' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="6" cy="6" r="2"></circle><circle cx="18" cy="18" r="2"></circle><path d="M8 6h3.5A3.5 3.5 0 0 1 15 9.5v1A3.5 3.5 0 0 0 18.5 14H20"></path></svg>}
            {item.icon === 'message' && <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 11.5a7.5 7.5 0 0 1-8 7.48 8.3 8.3 0 0 1-3.06-.62L4 20l1.48-4.3A7.42 7.42 0 0 1 4 11.5a8 8 0 0 1 16 0Z"></path><path d="M8.5 11.5h.01M12 11.5h.01M15.5 11.5h.01"></path></svg>}
          </span>
          <div><h2 class="text-sm font-semibold text-ink">{item.title}</h2><p class="mt-1 text-sm leading-6 text-ink/70">{item.description}</p></div>
        </li>
      ))}
    </ul>
  </div>
</section>
