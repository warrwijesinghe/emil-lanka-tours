---
import { resolveMediaUrl } from '@/lib/media';

interface Props {
  eyebrow?: string;
  title: string;
  description: string;
  imageUrl?: string | null;
  imageAlt?: string | null;
  meta?: string[];
  ctaHref?: string;
  ctaLabel?: string;
  secondaryCtaHref?: string;
  secondaryCtaLabel?: string;
}

const {
  eyebrow,
  title,
  description,
  imageUrl,
  imageAlt,
  meta = [],
  ctaHref,
  ctaLabel,
  secondaryCtaHref,
  secondaryCtaLabel
} = Astro.props;

const src = resolveMediaUrl(imageUrl);
---
<section class="container-shell pt-4 md:pt-6">
  <div class="grid items-start gap-6 md:gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:gap-12">
    <div class="space-y-4 pt-2 md:space-y-5 md:pt-4 order-2 lg:order-1">
      {eyebrow && <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-lotus">{eyebrow}</p>}
      <h1 class="max-w-3xl font-display text-4xl leading-tight text-ink sm:text-5xl md:text-6xl">{title}</h1>
      <p class="max-w-2xl text-sm leading-7 text-ink/74 sm:text-base md:text-lg md:leading-8">{description}</p>
      {meta.length > 0 && (
        <div class="flex flex-wrap gap-2.5 pt-1 text-sm text-ink/82">
          {meta.map((item) => (
            <span class="rounded-full bg-white px-4 py-2 shadow-soft">{item}</span>
          ))}
        </div>
      )}
      {(ctaHref && ctaLabel) && (
        <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap">
          <a href={ctaHref} class="inline-flex rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white">
            {ctaLabel}
          </a>
          {secondaryCtaHref && secondaryCtaLabel && <a href={secondaryCtaHref} class="inline-flex rounded-full border border-leaf/20 px-5 py-3 text-sm font-semibold text-leaf">{secondaryCtaLabel}</a>}
        </div>
      )}
    </div>
    <div class="order-1 overflow-hidden rounded-[1.75rem] md:rounded-[2rem] lg:order-2">
      <img
        src={src}
        alt={imageAlt || title}
        loading="eager"
        fetchpriority="high"
        width="1600"
        height="1000"
        sizes="(min-width: 1024px) 50vw, 100vw"
        class="h-[34svh] min-h-[240px] w-full object-cover sm:h-[38svh] md:h-[42svh] md:min-h-[320px] lg:h-[48svh] xl:h-[54svh]"
      />
    </div>
  </div>
</section>
