---
import SectionHeader from '@/components/SectionHeader.astro';

const steps = [
  { title: 'Share Your Travel Ideas', description: 'Tell us your dates, group size, interests, preferred pace and the places you hope to experience.', icon: 'message' },
  { title: 'Refine Your Private Route', description: 'Emil helps shape a realistic itinerary around travel times, overnight stops and the experiences that matter most to you.', icon: 'route' },
  { title: 'Confirm and Travel', description: 'Finalize your journey and receive clear local support as you prepare for and travel through Sri Lanka.', icon: 'check' }
];
---

<section class="home-band home-band-white" aria-labelledby="how-it-works-heading">
  <div class="container-shell py-10 md:py-12">
    <SectionHeader eyebrow="How It Works" title="Plan your Sri Lanka journey in three simple steps" description="Share what you have in mind, refine the journey with local guidance, and travel with a clear, practical plan." />
    <div class="relative mt-7 grid gap-5 md:grid-cols-2 lg:grid-cols-3 lg:gap-6">
      <div aria-hidden="true" class="pointer-events-none absolute left-[16.7%] right-[16.7%] top-9 hidden h-px bg-leaf/20 lg:block"></div>
      {steps.map((step, index) => (
        <article class="relative flex min-h-full flex-col rounded-[1.5rem] border border-ink/10 bg-white p-5 shadow-sm md:p-6">
          <div class="grid h-12 w-12 place-items-center rounded-2xl bg-leaf-soft text-leaf" aria-hidden="true">
            {step.icon === 'message' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path d="M5 5.75A2.75 2.75 0 0 1 7.75 3h8.5A2.75 2.75 0 0 1 19 5.75v5.5A2.75 2.75 0 0 1 16.25 14H11l-4.5 4v-4.2A2.74 2.74 0 0 1 5 11.25Z" /></svg>}
            {step.icon === 'route' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><circle cx="6" cy="5.5" r="2" /><circle cx="18" cy="18.5" r="2" /><path d="M7.7 6.6c4.5 1.5 1.6 6.1 5.2 7.3 1.5.5 2.5-.5 3.4-1.3" /></svg>}
            {step.icon === 'check' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="h-6 w-6"><path d="m5 12 4.3 4.3L19 6.7" /><circle cx="12" cy="12" r="9" /></svg>}
          </div>
          <p class="mt-5 text-xs font-extrabold uppercase tracking-[0.18em] text-lotus">Step {index + 1}</p>
          <h3 class="mt-2 font-display text-3xl leading-tight text-ink">{step.title}</h3>
          <p class="mt-3 text-sm leading-7 text-ink/72">{step.description}</p>
        </article>
      ))}
    </div>
    <a href="/plan-my-tour/" class="mt-7 inline-flex min-h-11 items-center justify-center rounded-xl bg-leaf px-5 text-sm font-semibold text-white transition hover:bg-leaf/90 focus:outline-none focus:ring-2 focus:ring-leaf focus:ring-offset-4">Plan My Tour</a>
  </div>
</section>
