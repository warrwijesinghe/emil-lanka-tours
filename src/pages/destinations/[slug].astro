---
export const prerender = false;
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import DayTourCard from '@/components/DayTourCard.astro';
import DetailHero from '@/components/DetailHero.astro';
import RichText from '@/components/RichText.astro';
import RoundTourCard from '@/components/RoundTourCard.astro';
import SiteLayout from '@/components/SiteLayout.astro';
import { roundTours } from '@/data/tours';
import { getDestinationSlugsInText } from '@/data/tour-destinations';
import { dayTours, getDestination } from '@/lib/content';

const destination = getDestination(Astro.params.slug || '');
if (!destination) return Astro.rewrite('/404');
const relatedDayTours = dayTours.filter((tour) => tour.destinations.some((item) => item.slug === destination.slug));
const relatedRoundTours = roundTours.filter((tour) => getDestinationSlugsInText(`${tour.routePoints.join(' ')} ${tour.itinerary.map((day) => `${day.route} ${day.experiences.join(' ')}`).join(' ')}`).includes(destination.slug));
---
<SiteLayout title={destination.seo.title} description={destination.seo.description} canonicalPath={`/destinations/${destination.slug}/`} image={destination.mainImageUrl}><Breadcrumbs items={[{href:'/',label:'Home'},{href:'/destinations/',label:'Destinations'},{label:destination.name}]} /><DetailHero eyebrow={destination.region} title={destination.name} description={destination.shortDescription} imageUrl={destination.mainImageUrl} imageAlt={destination.imageAlt} meta={[destination.suggestedVisitDuration]} ctaHref={`/plan-my-tour/?destination=${destination.slug}`} ctaLabel="Plan Around This Destination" /><section class="container-shell grid gap-8 py-8 lg:grid-cols-[1fr_.9fr]"><div class="card-surface p-6 md:p-8"><h2 class="font-display text-3xl text-ink md:text-4xl">Destination overview</h2><div class="mt-5"><RichText content={destination.description} /></div></div><div class="space-y-6"><div class="card-surface p-6"><h2 class="font-display text-2xl text-ink">Highlights</h2><ul class="mt-5 grid gap-3 text-sm leading-7 text-ink/72">{destination.highlights.map((item) => <li>• {item}</li>)}</ul></div><div class="card-surface p-6"><h2 class="font-display text-2xl text-ink">Good for</h2><ul class="mt-5 grid gap-3 text-sm leading-7 text-ink/72">{destination.bestFor.map((item) => <li>• {item}</li>)}</ul></div></div></section><section class="bg-[#F4ECFB]/60"><div class="container-shell py-10 md:py-12"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Related day tours</p><h2 class="mt-3 font-display text-3xl text-ink md:text-4xl">Day tours that include {destination.name}</h2>{relatedDayTours.length ? <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{relatedDayTours.map((tour) => <DayTourCard dayTour={tour} />)}</div> : <p class="mt-5 text-sm leading-7 text-ink/70">No day tours are currently listed for this destination. Emil can still tailor one around your plans.</p>}</div></section><section class="container-shell py-10 md:py-12"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Related round tours</p><h2 class="mt-3 font-display text-3xl text-ink md:text-4xl">Round tours that cover {destination.name}</h2>{relatedRoundTours.length ? <div class="mt-7 grid gap-5 md:grid-cols-2 xl:grid-cols-3">{relatedRoundTours.map((tour) => <RoundTourCard {tour} />)}</div> : <p class="mt-5 text-sm leading-7 text-ink/70">No round tours are currently listed for this destination.</p>}</section><CTASection title="Want this destination in your private route?" description="Emil can combine this destination with the right number of nights, travel pacing and nearby experiences." href={`/plan-my-tour/?destination=${destination.slug}`} label="Plan My Tour" /></SiteLayout>
