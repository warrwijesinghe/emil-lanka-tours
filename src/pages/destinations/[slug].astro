---
export const prerender = false;
import Breadcrumbs from '@/components/Breadcrumbs.astro'; import CTASection from '@/components/CTASection.astro'; import DetailHero from '@/components/DetailHero.astro'; import RichText from '@/components/RichText.astro'; import SiteLayout from '@/components/SiteLayout.astro'; import { getDestination } from '@/lib/content';
const destination = getDestination(Astro.params.slug || ''); if (!destination) return Astro.rewrite('/404');
---
<SiteLayout title={destination.seo.title} description={destination.seo.description} canonicalPath={`/destinations/${destination.slug}/`} image={destination.mainImageUrl}><Breadcrumbs items={[{href:'/',label:'Home'},{href:'/destinations/',label:'Destinations'},{label:destination.name}]} /><DetailHero eyebrow={destination.region} title={destination.name} description={destination.shortDescription} imageUrl={destination.mainImageUrl} imageAlt={destination.imageAlt} meta={[destination.suggestedVisitDuration]} ctaHref={`/plan-my-tour/?destination=${destination.slug}`} ctaLabel="Plan Around This Destination" /><section class="container-shell grid gap-8 py-8 lg:grid-cols-[1fr_.9fr]"><div class="card-surface p-6 md:p-8"><h2 class="font-display text-3xl text-ink md:text-4xl">Destination overview</h2><div class="mt-5"><RichText content={destination.description} /></div></div><div class="space-y-6"><div class="card-surface p-6"><h2 class="font-display text-2xl text-ink">Highlights</h2><ul class="mt-5 grid gap-3 text-sm leading-7 text-ink/72">{destination.highlights.map((item) => <li>• {item}</li>)}</ul></div><div class="card-surface p-6"><h2 class="font-display text-2xl text-ink">Good for</h2><ul class="mt-5 grid gap-3 text-sm leading-7 text-ink/72">{destination.bestFor.map((item) => <li>• {item}</li>)}</ul></div></div></section><CTASection title="Want this destination in your private route?" description="Emil can combine this destination with the right number of nights, travel pacing and nearby experiences." href={`/plan-my-tour/?destination=${destination.slug}`} label="Plan My Tour" /></SiteLayout>
