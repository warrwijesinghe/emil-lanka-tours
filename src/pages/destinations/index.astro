---
import ListingIntro from '@/components/ListingIntro.astro'; import DestinationCard from '@/components/DestinationCard.astro'; import SiteLayout from '@/components/SiteLayout.astro'; import { mainDestinationSlugs } from '@/data/destination-guides'; import { destinations } from '@/lib/content'; import { siteName } from '@/lib/site';
const mainDestinations = destinations.filter((destination) => mainDestinationSlugs.has(destination.slug));
---
<SiteLayout title={`Sri Lanka Destinations | ${siteName}`} description="Explore the Sri Lanka destinations Emil can combine into your private journey." canonicalPath="/destinations/"><ListingIntro eyebrow="Destinations" title="Places to shape around your journey" description="Explore Sri Lanka’s main cultural cities, hill-country bases, wildlife regions and coastal escapes. Attractions are included within the relevant destination page." compact /><section class="container-shell pb-12 md:pb-16"><div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">{mainDestinations.map((destination) => <DestinationCard {destination} />)}</div></section></SiteLayout>
