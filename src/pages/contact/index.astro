---
import Breadcrumbs from '@/components/Breadcrumbs.astro'; import SiteLayout from '@/components/SiteLayout.astro'; import { contactEmail, siteName, whatsappUrl } from '@/lib/site';
---
<SiteLayout title={`Contact Emil | ${siteName}`} description="Contact Chauffeur Emil Lanka Tours to plan a private Sri Lanka journey." canonicalPath="/contact/"><Breadcrumbs items={[{href:'/',label:'Home'},{label:'Contact'}]} /><section class="container-shell py-8 md:py-12"><div class="max-w-3xl"><p class="text-[11px] font-semibold uppercase tracking-[.26em] text-lotus">Contact Emil</p><h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl">Let’s start planning Sri Lanka</h1><p class="mt-4 text-base leading-8 text-ink/72">For a detailed itinerary request, use the Plan My Tour form. For a quick conversation, reach Emil on WhatsApp or email.</p></div><div class="mt-8 grid gap-5 md:grid-cols-2"><a href={whatsappUrl()} class="card-surface p-6 transition hover:-translate-y-1"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">WhatsApp</p><h2 class="mt-3 font-display text-3xl">Chat with Emil</h2><p class="mt-3 text-sm leading-7 text-ink/70">A convenient way to begin a conversation about your trip.</p></a><a href={`mailto:${contactEmail}`} class="card-surface p-6 transition hover:-translate-y-1"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Email</p><h2 class="mt-3 break-all font-display text-3xl">{contactEmail}</h2><p class="mt-3 text-sm leading-7 text-ink/70">For detailed enquiries and travel ideas.</p></a></div></section></SiteLayout>
