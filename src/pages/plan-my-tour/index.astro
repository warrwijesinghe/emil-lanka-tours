---
import Breadcrumbs from '@/components/Breadcrumbs.astro'; import PlanMyTourForm from '@/components/PlanMyTourForm.astro'; import SiteLayout from '@/components/SiteLayout.astro'; import { siteName } from '@/lib/site';
---
<SiteLayout title={`Plan My Tour | ${siteName}`} description="Send Emil your Sri Lanka travel plans and receive a personal response." canonicalPath="/plan-my-tour/"><Breadcrumbs items={[{href:'/',label:'Home'},{label:'Plan My Tour'}]} /><section class="container-shell py-8 md:py-10"><div class="max-w-3xl"><p class="text-[11px] font-semibold uppercase tracking-[.26em] text-lotus">Private Sri Lanka planning</p><h1 class="mt-3 font-display text-4xl text-ink sm:text-5xl">Tell Emil about your ideal journey</h1><p class="mt-4 text-base leading-8 text-ink/72">Share your travel dates, interests and preferred pace. Emil will review your request personally. This is an inquiry, not a booking confirmation.</p></div><div class="mt-8"><PlanMyTourForm /></div></section></SiteLayout>
