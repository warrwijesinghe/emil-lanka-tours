---
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import EmilReviews from '@/components/EmilReviews.astro';
import DetailHero from '@/components/DetailHero.astro';
import SiteLayout from '@/components/SiteLayout.astro';
import { roundTours, tourPackageDetails } from '@/data/tours';
import { emilReviews } from '@/data/emil-reviews';
import { getRoundTourDayImages, roundTourImages } from '@/lib/round-tour-images';

const tour = roundTours.find((item) => item.id.toLowerCase() === Astro.params.id?.toLowerCase());
if (!tour) return Astro.redirect('/tours/');
const heroImage = roundTourImages[tour.id];
const reviewStart = (Number(tour.id.slice(-3)) - 1) % emilReviews.length;
const tourReviews = [emilReviews[reviewStart], emilReviews[(reviewStart + 1) % emilReviews.length]];
const packageDetails = tourPackageDetails[tour.id];
---
<SiteLayout title={`${tour.title} | Chauffeur Emil`} description={tour.shortDescription} canonicalPath={`/tours/${tour.id.toLowerCase()}/`} image={heroImage.src} imageAlt={heroImage.alt}>
  <Breadcrumbs items={[{href:'/',label:'Home'},{href:'/tours/',label:'Round Tours'},{label:tour.title}]} />
  <DetailHero eyebrow="Private Sri Lanka round tour" title={tour.title} description={tour.shortDescription} imageUrl={heroImage.src} imageAlt={heroImage.alt} meta={[tour.durationLabel, 'Private chauffeur-driven vehicle', 'Tailor-made pace']} ctaHref={`/plan-my-tour/?tour=${tour.id}`} ctaLabel="Request This Tour" />
  <section class="container-shell grid gap-8 py-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
    <div class="grid gap-8">
      <section class="card-surface p-6 md:p-8">
        <p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Tour Overview</p>
        <h2 class="mt-3 font-display text-3xl text-ink md:text-4xl">A private journey, shaped around you</h2>
        <p class="mt-5 max-w-3xl text-sm leading-7 text-ink/72 md:text-base">This itinerary is a flexible starting point for your Sri Lanka journey. Emil can refine the pace, stays and experiences around your travel dates, interests and group.</p>
      </section>
      <section class="card-surface p-6 md:p-8" aria-labelledby="tour-highlights">
        <p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Tour Highlights</p>
        <h2 id="tour-highlights" class="mt-3 font-display text-2xl text-ink md:text-3xl">What you'll experience</h2>
        <p class="mt-2 max-w-3xl text-sm leading-6 text-ink/72">{tour.highlightsIntro}</p>
        <ul class="mt-5 grid gap-2.5 sm:grid-cols-2">
          {tour.highlights.map((highlight) => (
            <li class="flex items-start gap-3 rounded-2xl border border-ink/8 bg-white px-3.5 py-3 text-sm font-semibold leading-5 text-ink/80 shadow-sm">
              <span class="grid h-6 w-6 flex-none place-items-center rounded-full bg-lotus-soft text-xs font-bold text-lotus">✓</span>
              <span>{highlight}</span>
            </li>
          ))}
        </ul>
      </section>      <section class="bg-transparent py-1">
        <h2 class="font-display text-3xl text-ink md:text-4xl">Itinerary</h2>
        <div class="mt-4 grid gap-4 sm:gap-5">
          {tour.itinerary.map((day) => (
            <article class="rounded-2xl border border-ink/10 bg-white p-4 shadow-sm sm:rounded-[1.35rem] sm:p-5 md:p-6">
              <div class="flex items-start gap-2.5">
                <span class="inline-flex shrink-0 rounded-full bg-lotus-soft px-3 py-1.5 text-xs font-extrabold text-lotus">Day {String(day.day).padStart(2, '0')}</span>
                <div class="min-w-0">
                  <h3 class="font-display text-xl font-bold leading-tight text-leaf sm:text-2xl">{day.route}</h3>
                </div>
              </div>
              <div class="mt-4">
                <div>
                  <p class="max-w-3xl text-sm leading-6 text-ink/72">{day.description}</p>
                  <p class="mt-3 text-[11px] font-extrabold uppercase tracking-[.16em] text-lotus">Experiences</p>
                  <ul class="mt-2 flex flex-wrap gap-x-4 gap-y-1.5" aria-label="Experiences">
                    {day.experiences.map((experience) => (
                      <li class="flex items-start gap-2 text-xs font-semibold leading-5 text-ink/78"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-lotus"></span><span>{experience}</span></li>
                    ))}
                  </ul>
                </div>
                <div class="-mx-3 mt-4 grid grid-cols-1 gap-2 sm:mx-0 sm:grid-cols-2 sm:gap-3 lg:grid-cols-3" aria-label={`${day.route} photo gallery`}>
                  {getRoundTourDayImages(day).map((image) => (
                    <img src={image.src} alt={image.alt} loading="lazy" class="aspect-[4/3] w-full rounded-xl object-cover transition-transform duration-300 hover:scale-[1.02]" />
                  ))}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
      <section class="rounded-[1.35rem] border border-ink/10 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="included-excluded">
        <p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Tour service</p>
        <h2 id="included-excluded" class="mt-2 font-display text-3xl text-ink md:text-4xl">Included / Excluded</h2>
        <p class="mt-3 max-w-3xl text-sm leading-6 text-ink/72">These details cover the private chauffeur service for this itinerary. Your written quotation confirms the final arrangements.</p>
        <div class="mt-6 grid gap-6 md:grid-cols-2 md:gap-8">
          <div>
            <h3 class="text-sm font-extrabold uppercase tracking-[.16em] text-leaf">Included</h3>
            <ul class="mt-3 grid gap-3">
              {packageDetails.included.map((item) => (
                <li class="flex gap-3 text-sm leading-6 text-ink/78"><span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-leaf-soft text-xs font-bold text-leaf">✓</span><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div class="border-t border-ink/10 pt-6 md:border-l md:border-t-0 md:pl-8 md:pt-0">
            <h3 class="text-sm font-extrabold uppercase tracking-[.16em] text-lotus">Excluded</h3>
            <ul class="mt-3 grid gap-3">
              {packageDetails.excluded.map((item) => (
                <li class="flex gap-3 text-sm leading-6 text-ink/78"><span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-lotus-soft text-xs font-bold text-lotus">×</span><span>{item}</span></li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </div>
    <aside class="card-surface h-fit p-6 lg:sticky lg:top-24"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Plan with Emil</p><h2 class="mt-3 font-display text-3xl text-ink">Make this route your own</h2><p class="mt-3 text-sm leading-7 text-ink/70">Tell Emil your travel dates, group size and interests to shape this itinerary around you.</p><a href={`/plan-my-tour/?tour=${tour.id}`} class="mt-5 inline-flex rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white">Request This Tour</a><p class="mt-5 border-t border-ink/10 pt-4 text-xs text-ink/55">Temporary source reference: {tour.sourceReference}</p></aside>
  </section>
  <EmilReviews reviews={tourReviews} heading="Guests travelling with Emil" eyebrow="Guest reviews" />
  <CTASection title="Ready to plan this journey?" description="Emil can personalise the route around your dates and travel style." href={`/plan-my-tour/?tour=${tour.id}`} label="Plan My Tour" />
</SiteLayout>
