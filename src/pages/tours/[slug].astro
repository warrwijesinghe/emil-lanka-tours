---
export const prerender = false;
import Breadcrumbs from '@/components/Breadcrumbs.astro'; import DetailHero from '@/components/DetailHero.astro'; import RichText from '@/components/RichText.astro'; import CTASection from '@/components/CTASection.astro'; import SiteLayout from '@/components/SiteLayout.astro'; import { getTour } from '@/lib/content';
const tour = getTour(Astro.params.slug || ''); if (!tour) return Astro.rewrite('/404');
---
<SiteLayout title={tour.seo.title} description={tour.seo.description} canonicalPath={`/tours/${tour.slug}/`} image={tour.mainImageUrl} imageAlt={tour.imageAlt}><Breadcrumbs items={[{href:'/',label:'Home'},{href:'/tours/',label:'Tours'},{label:tour.title}]} /><DetailHero eyebrow={tour.durationLabel} title={tour.title} description={tour.shortDescription} imageUrl={tour.mainImageUrl} imageAlt={tour.imageAlt} meta={[`Route: ${tour.routePoints.join(' / ')}`]} ctaHref={`/plan-my-tour/?tour=${tour.slug}`} ctaLabel="Plan This Tour" /><section class="container-shell grid gap-8 py-8 lg:grid-cols-[minmax(0,1fr)_360px]"><div class="grid gap-8"><section class="card-surface p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus">Tour overview</p><h2 class="mt-3 font-display text-3xl text-ink md:text-4xl">A Sri Lanka journey with room to make it your own</h2><div class="mt-5"><RichText content={tour.description} /></div></section><section class="card-surface p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus">Tour highlights</p><div class="mt-6 grid gap-4 md:grid-cols-2">{tour.highlights.map((highlight) => <div class="flex gap-4 rounded-[1.35rem] border border-ink/8 bg-white p-4"><span class="grid h-9 w-9 place-items-center rounded-full bg-lotus-soft text-lg font-bold text-lotus">+</span><p class="self-center text-sm font-semibold leading-6 text-ink/78">{highlight}</p></div>)}</div></section><section class="card-surface bg-[#f3f0e4] p-6 md:p-8"><h2 class="font-display text-3xl text-ink md:text-4xl">Itinerary</h2><div class="mt-6 grid gap-5">{tour.itinerary.map((day) => <article class="rounded-[1.6rem] border border-ink/8 bg-white p-6"><span class="rounded-full bg-lotus-soft px-4 py-2 text-sm font-extrabold text-lotus">Day {String(day.dayNumber).padStart(2,'0')}</span><h3 class="mt-5 font-display text-2xl text-leaf">{day.title}</h3>{day.route && <p class="mt-3 text-sm font-extrabold text-leaf">{day.route}</p>}<p class="mt-4 text-sm leading-7 text-ink/72">{day.description}</p><ul class="mt-4 flex flex-wrap gap-2">{day.experiences.map((experience) => <li class="rounded-full bg-leaf-soft px-3 py-1 text-xs font-semibold text-leaf">{experience}</li>)}</ul></article>)}</div></section><section class="grid gap-5 md:grid-cols-2"><div class="card-surface p-6"><h2 class="text-xs font-extrabold uppercase tracking-[0.2em] text-leaf">What’s included</h2><ul class="mt-5 grid gap-3 text-sm leading-7 text-ink/72">{tour.included.map((item) => <li>• {item}</li>)}</ul></div><div class="card-surface p-6"><h2 class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus">What’s not included</h2><ul class="mt-5 grid gap-3 text-sm leading-7 text-ink/72">{tour.excluded.map((item) => <li>• {item}</li>)}</ul></div></section></div><aside class="card-surface h-fit p-6 lg:sticky lg:top-24"><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus">Make it your own</p><h2 class="mt-3 font-display text-3xl">Plan this tour with Emil</h2><p class="mt-3 text-sm leading-7 text-ink/70">Use this route as a starting point, then personalise the details around your dates and interests.</p><a href={`/plan-my-tour/?tour=${tour.slug}`} class="mt-5 inline-flex rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white">Plan This Tour</a></aside></section><CTASection title="Ready to shape this route around your trip?" description="Tell Emil what matters most and he will help plan a private Sri Lanka journey." href={`/plan-my-tour/?tour=${tour.slug}`} label="Plan My Tour" /></SiteLayout>
