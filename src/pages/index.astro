---
import SiteLayout from '@/components/SiteLayout.astro';
import HomepageHero from '@/components/HomepageHero.astro';
import HomepageTrustStrip from '@/components/HomepageTrustStrip.astro';
import HomepageJourneyChoices from '@/components/HomepageJourneyChoices.astro';
import HomepageFeaturedTours from '@/components/HomepageFeaturedTours.astro';
import HomepageDestinationGrid from '@/components/HomepageDestinationGrid.astro';
import HomepageHowItWorks from '@/components/HomepageHowItWorks.astro';
import HomepageFinalCta from '@/components/HomepageFinalCta.astro';
import { destinations, tours } from '@/lib/content';
import { homepageDescription, homepageTitle } from '@/lib/site';
---
<SiteLayout title={homepageTitle} description={homepageDescription} canonicalPath="/" image="/images/hero/optimized/home-hero-tea-picker-sri-lanka-desktop.webp"><HomepageHero /><HomepageTrustStrip /><HomepageJourneyChoices /><HomepageFeaturedTours tours={tours.filter((tour) => tour.featured)} /><section class="home-band home-band-green"><div class="container-shell grid gap-7 py-10 md:py-12 lg:grid-cols-[0.78fr_1.22fr] lg:items-center"><img src="/images/driver-guides/emil/emil-profile.webp" alt="Emil Jayasekara, Sri Lanka chauffeur" width="949" height="949" loading="lazy" class="aspect-[4/5] w-full rounded-[1.75rem] object-cover shadow-soft" /><div><p class="text-xs font-extrabold uppercase tracking-[0.2em] text-lotus">Your local chauffeur</p><h2 class="mt-3 font-display text-4xl text-ink sm:text-5xl">Plan your Sri Lanka journey with Emil</h2><p class="mt-4 max-w-3xl text-base leading-8 text-ink/72">With decades of on-the-road experience in Sri Lanka, Emil brings practical local route knowledge, a personal welcome and a pace shaped around your trip.</p><div class="mt-7 flex flex-wrap gap-3"><a href="/plan-my-tour/" class="rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white">Plan My Tour</a><a href="/about/" class="rounded-full border border-leaf/20 px-5 py-3 text-sm font-semibold text-leaf">Meet Emil</a></div></div></div></section><HomepageDestinationGrid destinations={destinations.filter((destination) => destination.featured)} /><HomepageHowItWorks /><HomepageFinalCta /></SiteLayout>
