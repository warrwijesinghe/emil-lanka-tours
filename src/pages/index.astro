---
import SiteLayout from '@/components/SiteLayout.astro';
import HomepageHero from '@/components/HomepageHero.astro';
import HomepageTrustStrip from '@/components/HomepageTrustStrip.astro';
import HomepageJourneyChoices from '@/components/HomepageJourneyChoices.astro';
import HomepageDestinationGrid from '@/components/HomepageDestinationGrid.astro';
import HomepageHowItWorks from '@/components/HomepageHowItWorks.astro';
import HomepageFinalCta from '@/components/HomepageFinalCta.astro';
import EmilReviews from '@/components/EmilReviews.astro';
import { emilReviews } from '@/data/emil-reviews';
import { destinations } from '@/lib/content';
import { homepageDescription, homepageTitle } from '@/lib/site';
---
<SiteLayout title={homepageTitle} description={homepageDescription} canonicalPath="/" image="/images/hero/optimized/home-hero-tea-picker-sri-lanka-desktop.webp"><HomepageHero /><HomepageTrustStrip /><HomepageJourneyChoices /><EmilReviews reviews={emilReviews.slice(0, 3)} heading="Why guests recommend Emil" /><HomepageDestinationGrid destinations={destinations.filter((destination) => destination.featured)} /><HomepageHowItWorks /><HomepageFinalCta /></SiteLayout>
