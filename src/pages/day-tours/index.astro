---
import ListingIntro from '@/components/ListingIntro.astro'; import SiteLayout from '@/components/SiteLayout.astro'; import DayTourCard from '@/components/DayTourCard.astro'; import { visibleDayTours } from '@/lib/content'; import { siteName } from '@/lib/site';
---
<SiteLayout title={`Private Sri Lanka Day Tours | ${siteName}`} description="Browse flexible private day tours with Chauffeur Emil Lanka Tours." canonicalPath="/day-tours/"><ListingIntro eyebrow="Day Tours" title="Flexible day trips for your Sri Lanka journey" description="Explore cultural sites, wildlife parks and memorable local experiences as standalone days or additions to a longer itinerary." compact /><section class="container-shell pb-12 md:pb-16"><div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">{visibleDayTours.map((dayTour) => <DayTourCard {dayTour} />)}</div></section></SiteLayout>
