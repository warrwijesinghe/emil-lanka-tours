---
export const prerender = false;
import Breadcrumbs from '@/components/Breadcrumbs.astro'; import CTASection from '@/components/CTASection.astro'; import DetailHero from '@/components/DetailHero.astro'; import RichText from '@/components/RichText.astro'; import SiteLayout from '@/components/SiteLayout.astro'; import { getDayTour } from '@/lib/content';
const dayTour = getDayTour(Astro.params.slug || ''); if (!dayTour) return Astro.rewrite('/404');
---
<SiteLayout title={dayTour.seo.title} description={dayTour.seo.description} canonicalPath={`/day-tours/${dayTour.slug}/`} image={dayTour.mainImageUrl}><Breadcrumbs items={[{href:'/',label:'Home'},{href:'/day-tours/',label:'Day Tours'},{label:dayTour.title}]} /><DetailHero eyebrow={dayTour.durationLabel} title={dayTour.title} description={dayTour.shortDescription} imageUrl={dayTour.mainImageUrl} imageAlt={dayTour.imageAlt} meta={dayTour.categories} ctaHref={`/plan-my-tour/?day-tour=${dayTour.slug}`} ctaLabel="Plan This Day Tour" /><section class="container-shell grid gap-6 py-8 md:grid-cols-[1.2fr_.8fr]"><div class="card-surface p-6 md:p-8"><h2 class="font-display text-3xl text-ink">Day tour overview</h2><div class="mt-5"><RichText content={dayTour.description} /></div></div><div class="card-surface p-6 md:p-8"><h2 class="font-display text-2xl text-ink">Highlights</h2><ul class="mt-5 grid gap-3 text-sm leading-7 text-ink/72">{dayTour.highlights.map((item) => <li>• {item}</li>)}</ul></div></section><CTASection title="Want to include this in a wider itinerary?" description="Tell Emil your dates and preferred pace and he can add this experience to a private Sri Lanka route." href={`/plan-my-tour/?day-tour=${dayTour.slug}`} label="Plan My Tour" /></SiteLayout>
