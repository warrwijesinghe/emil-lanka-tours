---
export const prerender = false;
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CTASection from '@/components/CTASection.astro';
import DetailHero from '@/components/DetailHero.astro';
import SiteLayout from '@/components/SiteLayout.astro';
import { getVisibleDayTour } from '@/lib/content';

const dayTour = getVisibleDayTour(Astro.params.slug || '');
if (!dayTour) return Astro.rewrite('/404');
---
<SiteLayout title={dayTour.seo.title} description={dayTour.seo.description} canonicalPath={`/day-tours/${dayTour.slug}/`} image={dayTour.mainImageUrl}>
  <Breadcrumbs items={[{ href: '/', label: 'Home' }, { href: '/day-tours/', label: 'Day Tours' }, { label: dayTour.title }]} />
  <DetailHero eyebrow="Private Sri Lanka day tour" title={dayTour.title} description={dayTour.shortDescription} imageUrl={dayTour.mainImageUrl} imageAlt={dayTour.imageAlt} meta={[dayTour.durationLabel, dayTour.duration, 'Private chauffeur-driven vehicle']} ctaHref={`/plan-my-tour/?day-tour=${dayTour.slug}`} ctaLabel="Plan This Day Tour" />
  <section class="container-shell grid gap-8 py-8 lg:grid-cols-[minmax(0,1fr)_340px] lg:items-start">
    <div class="grid gap-7">
      <section class="card-surface p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Tour overview</p><h2 class="mt-3 font-display text-3xl text-ink">About this day tour</h2><p class="mt-4 text-base leading-8 text-ink/75">{dayTour.description}</p><dl class="mt-6 grid gap-4 border-t border-ink/10 pt-5 sm:grid-cols-2"><div><dt class="text-xs font-extrabold uppercase tracking-[.16em] text-lotus">Duration</dt><dd class="mt-1 text-sm font-semibold text-ink">{dayTour.duration}</dd></div><div><dt class="text-xs font-extrabold uppercase tracking-[.16em] text-lotus">Destinations covered</dt><dd class="mt-1 text-sm font-semibold text-ink">{dayTour.destinationsCovered.join(' · ')}</dd></div></dl></section>
      <section class="grid gap-5 md:grid-cols-2" aria-label="Pickup and drop-off locations"><div class="card-surface p-6"><h2 class="font-display text-2xl text-ink">Pickup locations</h2><ul class="mt-4 grid gap-2.5">{dayTour.pickupLocations.map((location) => <li class="flex gap-2 text-sm leading-6 text-ink/75"><span class="text-leaf">✓</span>{location}</li>)}</ul></div><div class="card-surface p-6"><h2 class="font-display text-2xl text-ink">Drop-off locations</h2><ul class="mt-4 grid gap-2.5">{dayTour.dropLocations.map((location) => <li class="flex gap-2 text-sm leading-6 text-ink/75"><span class="text-leaf">✓</span>{location}</li>)}</ul></div></section>
      <section class="card-surface p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Experiences</p><h2 class="mt-3 font-display text-3xl text-ink">What you can expect</h2><ul class="mt-5 grid gap-3 sm:grid-cols-2">{dayTour.experiences.map((experience) => <li class="flex items-start gap-3 rounded-2xl bg-leaf-soft px-4 py-3 text-sm font-semibold leading-6 text-leaf"><span>✓</span><span>{experience}</span></li>)}</ul></section>
      <section class="card-surface p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Reasons to book</p><h2 class="mt-3 font-display text-3xl text-ink">Why choose this tour?</h2><ul class="mt-5 grid gap-3 sm:grid-cols-2">{dayTour.reasonsToBook.map((reason) => <li class="flex items-start gap-3 text-sm leading-6 text-ink/78"><span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-leaf text-xs font-bold text-white">✓</span><span>{reason}</span></li>)}</ul></section>
      <section class="card-surface p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Simple plan</p><h2 class="mt-3 font-display text-3xl text-ink">Tour itinerary</h2><ol class="mt-6 grid gap-4">{dayTour.itinerary.map((step, index) => <li class="relative border-l-2 border-lotus/60 pl-5"><span class="absolute -left-[11px] top-0 grid h-5 w-5 place-items-center rounded-full bg-lotus text-[10px] font-bold text-white">{index + 1}</span><p class="text-xs font-extrabold uppercase tracking-[.16em] text-lotus">{step.time}</p><h3 class="mt-1 font-display text-xl text-ink">{step.title}</h3><p class="mt-1 text-sm leading-6 text-ink/72">{step.description}</p></li>)}</ol></section>
      <section class="rounded-[1.5rem] border border-ink/10 bg-white p-6 shadow-soft md:p-8"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Tour service</p><h2 class="mt-3 font-display text-3xl text-ink">Included / Excluded</h2><div class="mt-6 grid gap-6 md:grid-cols-2"><div><h3 class="text-sm font-extrabold uppercase tracking-[.16em] text-leaf">Included</h3><ul class="mt-3 grid gap-3">{dayTour.included.map((item) => <li class="flex gap-3 text-sm leading-6 text-ink/78"><span class="text-leaf">✓</span><span>{item}</span></li>)}</ul></div><div class="border-t border-ink/10 pt-6 md:border-l md:border-t-0 md:pl-7 md:pt-0"><h3 class="text-sm font-extrabold uppercase tracking-[.16em] text-lotus">Excluded</h3><ul class="mt-3 grid gap-3">{dayTour.excluded.map((item) => <li class="flex gap-3 text-sm leading-6 text-ink/78"><span class="text-lotus">×</span><span>{item}</span></li>)}</ul></div></div></section>
      <section class="card-surface p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Important information</p><h2 class="mt-3 font-display text-3xl text-ink">Know before you go</h2><ul class="mt-5 grid gap-2.5">{dayTour.importantInformation.map((item) => <li class="flex gap-3 text-sm leading-6 text-ink/78"><span class="text-lotus">•</span><span>{item}</span></li>)}</ul></section>
      <section class="card-surface overflow-hidden"><div class="p-6 md:p-8"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Entry tickets</p><h2 class="mt-3 font-display text-3xl text-ink">Ticket information by location</h2><p class="mt-3 text-sm leading-6 text-ink/70">Prices are planning guidance only. They are not included in the tour price and may change without notice.</p></div><div class="overflow-x-auto border-t border-ink/10"><table class="min-w-full text-left text-sm"><thead class="bg-leaf-soft text-xs uppercase tracking-[.12em] text-leaf"><tr><th class="px-6 py-4 font-extrabold">Location</th><th class="px-6 py-4 font-extrabold">Ticket</th><th class="px-6 py-4 font-extrabold">Price / notes</th></tr></thead><tbody>{dayTour.ticketInformation.map((ticket) => <tr class="border-t border-ink/8 align-top"><td class="px-6 py-4 font-semibold text-ink">{ticket.location}</td><td class="px-6 py-4 text-ink/70">{ticket.ticketRequired ? 'Ticket required' : 'No ticket required'}</td><td class="px-6 py-4 leading-6 text-ink/70">{ticket.ticketPrice}{ticket.notes && <><br /><span class="text-xs">{ticket.notes}</span></>}</td></tr>)}</tbody></table></div></section>
    </div>
    <aside class="card-surface h-fit p-6 lg:sticky lg:top-24"><p class="text-xs font-extrabold uppercase tracking-[.2em] text-lotus">Plan with Emil</p><h2 class="mt-3 font-display text-3xl text-ink">Make this day your own</h2><p class="mt-3 text-sm leading-7 text-ink/70">Tell Emil your date, group size and preferred pace. He can tailor this route around your stay.</p><a href={`/plan-my-tour/?day-tour=${dayTour.slug}`} class="mt-5 inline-flex rounded-full bg-leaf px-5 py-3 text-sm font-semibold text-white">Plan This Day Tour</a></aside>
  </section>
  <CTASection title="Ready to plan this day?" description="Emil can tailor the timing, pickup point and experiences around your Sri Lanka journey." href={`/plan-my-tour/?day-tour=${dayTour.slug}`} label="Plan My Tour" />
</SiteLayout>
